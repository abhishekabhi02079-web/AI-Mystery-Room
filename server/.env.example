# AI Mystery Room Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local connection string
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ai-mystery-room?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ai-mystery-room?retryWrites=true&w=majority

# Google Gemini API Key & Model Configuration
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
